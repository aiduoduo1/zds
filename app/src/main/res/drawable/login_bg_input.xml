<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/login_input_focus" />
            <stroke android:width="1.5dp" android:color="@color/login_blue_bright" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_input" />
            <stroke android:width="1dp" android:color="@color/login_line" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
