<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="#0758D9" android:startColor="#128FFF" />
            <stroke android:width="1.5dp" android:color="#8CE6FF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:centerColor="#087CFF" android:endColor="#0755D8" android:startColor="#14BFFF" />
            <stroke android:width="1.5dp" android:color="#70DBFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
