<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pda_bg_page">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/j_space_12">
        <TextView android:id="@+id/tvCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/j_color_text_primary" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBaseInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_10" android:background="@drawable/pda_bg_card" android:lineSpacingExtra="5dp" android:padding="@dimen/j_space_12" android:textColor="@color/j_color_text_primary" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_16" android:text="产品明细" android:textColor="@color/j_color_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/layoutProducts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_8" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_16" android:text="打印记录" android:textColor="@color/j_color_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/layoutRecords" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_8" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
