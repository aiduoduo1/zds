<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/j_space_16">

        <Button
            android:id="@+id/btnForegroundService"
            style="@style/JStyle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Foreground Service Notification" />

        <Button
            android:id="@+id/btnCamera"
            style="@style/JStyle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:text="Camera" />

        <Button
            android:id="@+id/btnAlbum"
            style="@style/JStyle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:text="Album" />

        <Button
            android:id="@+id/btnBluetooth"
            style="@style/JStyle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:text="Bluetooth" />

        <Button
            android:id="@+id/btnLocation"
            style="@style/JStyle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:text="Location" />

        <Button
            android:id="@+id/btnVibrate"
            style="@style/JStyle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:text="Vibrate" />

        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/JStyle.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/j_space_12"
            android:text="Open App Settings" />

        <TextView
            android:id="@+id/tvResult"
            style="@style/JText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_16"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
