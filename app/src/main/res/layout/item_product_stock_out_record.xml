<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JStyle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/j_space_10">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tvRecordIndex" style="@style/JText.Caption" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/j_bg_button_secondary" android:gravity="center" android:textColor="@color/j_color_primary" android:textStyle="bold" />
        <TextView android:id="@+id/tvRecordCode" style="@style/JText.SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/j_space_8" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/btnDeleteRecord" style="@style/JStyle.Button.Text" android:layout_width="wrap_content" android:layout_height="@dimen/j_small_button_height" android:gravity="center" android:text="撤回" />
    </LinearLayout>
    <TextView android:id="@+id/tvRecordQuantity" style="@style/JText.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_6" />
    <TextView android:id="@+id/tvRecordOperator" style="@style/JText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_2" />
    <TextView android:id="@+id/tvRecordTime" style="@style/JText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_2" />
</LinearLayout>
