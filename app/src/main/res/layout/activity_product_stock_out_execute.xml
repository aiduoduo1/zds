<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/j_space_12">

    <LinearLayout style="@style/JStyle.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/j_space_10">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvExecuteProduct" style="@style/JText.SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/tvExecuteStatus" style="@style/JText.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pda_bg_status_warning" android:paddingHorizontal="@dimen/j_space_6" android:paddingVertical="@dimen/j_space_2" android:textColor="@color/j_color_warning" />
        </LinearLayout>
        <TextView android:id="@+id/tvExecuteSummary" style="@style/JText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_8" android:text="需求 0 台 · 已出库 0 台" android:textStyle="bold" />
    </LinearLayout>

    <com.jj.ui.input.JInputLayout
        android:id="@+id/inputStockOutScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        app:jInputClearEnabled="true"
        app:jInputCompact="true"
        app:jInputHint="请扫描 PRO码或流转单码"
        app:jInputMode="scan"
        app:jInputScanOnly="true"
        app:jInputSelectAllOnFocus="true"
        app:jInputTitle="出库扫码" />

    <TextView style="@style/JText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/j_space_12" android:text="已出库 PRO" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/j_space_6" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRecords" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" />
        <com.jj.ui.widget.JEmptyView android:id="@+id/emptyRecords" android:layout_width="match_parent" android:layout_height="match_parent" app:jDescription="扫描成功的 PRO 将展示在这里" app:jTitle="暂无出库记录" />
    </FrameLayout>
    <Button android:id="@+id/btnFinishChildTask" style="@style/JStyle.Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/j_button_height" android:layout_marginTop="@dimen/j_space_8" android:text="结束子任务" />
</LinearLayout>
