<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".feature.debugplan.ui.DebugPlanBatchActivity"
    android:padding="@dimen/j_space_12"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        style="@style/JStyle.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/j_space_10">

        <TextView
            android:id="@+id/tvPlanCode"
            style="@style/JText.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            tools:text="IQC20260526008" />

        <TextView
            android:id="@+id/tvPlanMeta"
            style="@style/JText.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_4"
            android:maxLines="2"
            tools:text="030101-247 / 12英寸灯接头组件 / SWITCH-12" />

        <ProgressBar
            android:id="@+id/progressBatch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/j_space_8"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/j_color_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBatchProgress"
                    style="@style/JText.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 / 3" />

                <TextView
                    style="@style/JText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="批次进度" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSampleProgress"
                    style="@style/JText.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="10 / 20" />

                <TextView
                    style="@style/JText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已检/应检" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNgProgress"
                    style="@style/JText.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 / 1" />

                <TextView
                    style="@style/JText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不良/上限" />
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/JText.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="批次列表" />

        <TextView
            android:id="@+id/btnCreateBatch"
            style="@style/JStyle.Button.Primary"
            android:layout_width="116dp"
            android:layout_height="@dimen/j_button_height"
            android:gravity="center"
            android:textStyle="bold"
            android:text="创建批次" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_4"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBatches"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_debug_plan_batch" />

            <com.jj.ui.widget.JEmptyView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:jActionText="刷新"
                app:jDescription="当前调试计划还没有执行批次"
                app:jTitle="暂无批次" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
