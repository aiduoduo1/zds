<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/j_space_8"
    tools:context=".feature.repair.ui.RepairActivity"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        android:id="@+id/layoutScanCard"
        style="@style/JStyle.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/j_space_8">

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputSn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:jInputClearEnabled="true"
            app:jInputCompact="true"
            app:jInputHint=""
            app:jInputMode="scan"
            app:jInputSelectAllOnFocus="true"
            app:jInputTitle="扫描不良 SN/PRO 码" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_8"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/j_space_12">

            <TextView
                android:id="@+id/tvEmpty"
                style="@style/JText.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="180dp"
                android:text="请扫描不良 SN 或 PRO 码\n系统会检查尚未关闭的不良记录" />

            <LinearLayout
                android:id="@+id/layoutSummaryPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    style="@style/JStyle.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/j_space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/JText.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="当前 SN/PRO"
                                android:textColor="@color/j_color_text_disabled" />

                            <TextView
                                android:id="@+id/tvSn"
                                style="@style/JText.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/j_space_2"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="SN2606260005" />
                        </LinearLayout>

                        <com.jj.ui.widget.JStatusTagView
                            android:id="@+id/tagStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/j_space_8" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:background="@color/j_color_line_light" />

                    <TextView
                        style="@style/JText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="不良现象"
                        android:textColor="@color/j_color_text_disabled" />

                    <TextView
                        android:id="@+id/tvNgPhenomena"
                        style="@style/JText.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:textColor="@color/j_color_danger"
                        tools:text="电流值异常" />

                    <TextView
                        style="@style/JText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="不良说明"
                        android:textColor="@color/j_color_text_disabled" />

                    <TextView
                        android:id="@+id/tvNgRemark"
                        style="@style/JText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="3"
                        tools:text="变压器二次对地绝缘【10～50】，实际数值:0；\n变压器一次对地绝缘【500～1000】，实际数值:0；\n变压器前接线板异常@检查外观异常" />

                    <Button
                        android:id="@+id/btnToggleRemark"
                        style="@style/JStyle.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:minHeight="36dp"
                        android:text="展开"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/btnStartRepair"
                        style="@style/JStyle.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="填写维修结果" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRepairForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    style="@style/JStyle.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/j_space_10">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/JText.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="填写维修结果" />

                        <Button
                            android:id="@+id/btnBackToSummary"
                            style="@style/JStyle.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:text="返回问题概览" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFormSn"
                        style="@style/JText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:textColor="@color/j_color_text_disabled"
                        tools:text="SN2606260005 · 电流值异常" />

                    <LinearLayout
                        android:id="@+id/layoutProductRepair"
                        style="@style/JStyle.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:orientation="vertical"
                        android:padding="@dimen/j_space_8"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/JText.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="成品维修" />

                        <RadioGroup
                            android:id="@+id/groupRepairMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/j_space_6"
                            android:checkedButton="@id/rbNormalRepair"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbNormalRepair"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="常规维修" />

                            <RadioButton
                                android:id="@+id/rbReplaceRepair"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="换件" />
                        </RadioGroup>

                        <TextView
                            style="@style/JText.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/j_space_8"
                            android:text="损坏关键部件（单选）" />

                        <LinearLayout
                            android:id="@+id/layoutKeyPartOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/j_space_4"
                            android:orientation="vertical" />

                        <TextView
                            style="@style/JText.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/j_space_6"
                            android:gravity="center"
                            android:text="或填写非关键部件物料号（与上方互斥）"
                            android:textColor="@color/j_color_text_disabled" />

                        <EditText
                            android:id="@+id/editFaultMaterialCode"
                            style="@style/JStyle.EditText.Normal"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/j_space_4"
                            android:hint="输入损坏/更换的物料号"
                            android:singleLine="true" />

                        <com.jj.ui.input.JInputLayout
                            android:id="@+id/inputReplacementSn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/j_space_8"
                            android:visibility="gone"
                            app:jInputClearEnabled="true"
                            app:jInputCompact="true"
                            app:jInputMode="scan"
                            app:jInputTitle="扫描新关键部件 SN 码"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        style="@style/JText.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="维修结果" />

                    <TextView
                        android:id="@+id/tvRepairResult"
                        style="@style/JStyle.EditText.Normal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:gravity="center_vertical"
                        android:text="请选择维修结果" />

                    <TextView
                        style="@style/JText.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="不良原因" />

                    <TextView
                        android:id="@+id/tvNgReason"
                        style="@style/JStyle.EditText.Normal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:gravity="center_vertical"
                        android:text="请选择不良原因" />

                    <TextView
                        style="@style/JText.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="维修人" />

                    <EditText
                        android:id="@+id/editRepairBy"
                        style="@style/JStyle.EditText.Normal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:hint="请输入维修人"
                        android:maxLength="10"
                        android:singleLine="true" />

                    <TextView
                        style="@style/JText.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:text="维修说明" />

                    <EditText
                        android:id="@+id/editRepairDesc"
                        style="@style/JStyle.EditText.Normal"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:layout_marginTop="@dimen/j_space_4"
                        android:gravity="start|top"
                        android:hint="记录维修动作、替换物料、异常原因或处理说明"
                        android:inputType="textMultiLine"
                        android:maxLength="1000"
                        android:paddingTop="@dimen/j_space_8"
                        android:singleLine="false"
                        android:textColorHint="?android:attr/textColorHint" />

                    <TextView
                        android:id="@+id/tvPhoto"
                        style="@style/JText.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_8"
                        tools:text="维修照片：0 张" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTakePhoto"
                            style="@style/JStyle.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_marginEnd="@dimen/j_space_8"
                            android:layout_weight="1"
                            android:text="拍照上传" />

                        <RadioGroup
                            android:id="@+id/groupRepairPhotoUploadMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkedButton="@id/rbRepairPhotoCompressed"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbRepairPhotoCompressed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="压缩图" />

                            <RadioButton
                                android:id="@+id/rbRepairPhotoOriginal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="原图" />
                        </RadioGroup>
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scrollPhotoList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_6"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layoutPhotoList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/j_space_10"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSave"
                            style="@style/JStyle.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_marginEnd="@dimen/j_space_6"
                            android:layout_weight="1"
                            android:text="保存" />

                        <Button
                            android:id="@+id/btnSubmit"
                            style="@style/JStyle.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/j_space_6"
                            android:layout_weight="1"
                            android:text="提交" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
