<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:theme="@style/Theme.Zds">

    <com.jj.ui.toolbar.JiangToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/j_toolbar_height" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/pda_bg_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/j_space_8"
        android:paddingTop="@dimen/j_space_6"
        android:paddingEnd="@dimen/j_space_8"
        android:paddingBottom="@dimen/j_space_6">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="首页"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabDebug"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/j_space_4"
            android:layout_weight="1"
            android:gravity="center"
            android:text="调试"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabProduce"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/j_space_4"
            android:layout_weight="1"
            android:gravity="center"
            android:text="生产"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
