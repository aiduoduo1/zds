<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:theme="@style/Theme.Zds">

    <com.jj.ui.toolbar.JiangToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/j_toolbar_height" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/j_color_bg_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/j_space_8">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="首页"
            android:textColor="@color/j_color_primary"
            android:textSize="@dimen/j_text_size_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabDebug"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:gravity="center"
            android:text="调试"
            android:textColor="@color/j_color_primary"
            android:textSize="@dimen/j_text_size_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabProduce"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:gravity="center"
            android:text="生产"
            android:textColor="@color/j_color_primary"
            android:textSize="@dimen/j_text_size_md"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
