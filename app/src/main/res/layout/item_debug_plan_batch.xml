<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/j_space_10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBatchNo"
            style="@style/JText.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            tools:text="BATCH-001" />

        <com.jj.ui.widget.JStatusTagView
            android:id="@+id/tagStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_8" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBatchMeta"
        style="@style/JText.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_4"
        android:maxLines="2"
        tools:text="序号：1 / 创建：2026-05-26 14:35:02" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/JText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="箱单" />

        <TextView
            android:id="@+id/tvBoxCount"
            style="@style/JText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_6"
            tools:text="2" />

        <TextView
            style="@style/JText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_16"
            android:text="数量" />

        <TextView
            android:id="@+id/tvTotalQty"
            style="@style/JText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_6"
            tools:text="20" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvEnter"
            style="@style/JText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="进入执行" />
    </LinearLayout>
</LinearLayout>
