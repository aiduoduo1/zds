<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/j_space_8">

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/j_space_8"
            android:text="步骤 1 / 2：扫描调光器工位"
            android:textColor="@color/j_color_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:jInputClearEnabled="true"
            app:jInputCompact="true"
            app:jInputHint="扫描调光器工位二维码"
            app:jInputMode="scan"
            app:jInputSelectAllOnFocus="true"
            app:jInputTitle="调光器工位" />

        <TextView
            android:id="@+id/tvStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:paddingHorizontal="@dimen/j_space_8"
            android:textColor="@color/j_color_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/j_space_12"
            android:background="#E6EAF0" />

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:jInputClearEnabled="true"
            app:jInputCompact="true"
            app:jInputHint="完成工位校验后扫描 PRO 标签"
            app:jInputMode="scan"
            app:jInputSelectAllOnFocus="true"
            app:jInputTitle="PRO 标签" />

        <LinearLayout
            android:id="@+id/layoutBindingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_12"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/j_space_12"
                android:textColor="#27364A"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvAirportTitle"
                style="@style/JText.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/j_space_12"
                android:text="机场" />
            <Spinner
                android:id="@+id/spinnerAirport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/j_input_height"
                android:layout_marginTop="@dimen/j_space_4"
                android:background="@drawable/pda_bg_dimmer_airport_select"
                android:paddingStart="@dimen/j_space_12"
                android:paddingEnd="@dimen/j_space_12"
                android:spinnerMode="dropdown" />
            <com.jj.ui.input.JInputLayout
                android:id="@+id/inputProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/j_space_8"
                app:jInputCompact="true"
                app:jInputHint="输入备注（可手工填写）"
                app:jInputMode="text"
                app:jInputTitle="备注" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirm"
            style="@style/JStyle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/j_button_height"
            android:layout_marginTop="@dimen/j_space_16"
            android:text="确认绑定"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
