<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/j_space_10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndex"
            style="@style/JText.Caption"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/j_bg_button_secondary"
            android:gravity="center"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold"
            tools:text="1" />

        <TextView
            android:id="@+id/tvBoxNo"
            style="@style/JText.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:maxLines="1"
            tools:text="BOX-20260604001" />

        <TextView
            android:id="@+id/btnRemoveBox"
            style="@style/JStyle.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/j_small_button_height"
            android:gravity="center"
            android:text="删除" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBoxMeta"
        style="@style/JText.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_4"
        android:maxLines="2"
        tools:text="030101-247 / 订单：SO-001 / 批次：LOT-001" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/JText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数量" />

        <TextView
            android:id="@+id/tvQty"
            style="@style/JText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_6"
            tools:text="20" />

        <TextView
            style="@style/JText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_16"
            android:text="SN" />

        <TextView
            android:id="@+id/tvSnRange"
            style="@style/JText.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/j_space_6"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            tools:text="SN001 - SN020" />
    </LinearLayout>
</LinearLayout>
