<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pda_bg_page"
    android:orientation="vertical"
    android:padding="@dimen/j_space_12"
    tools:theme="@style/Theme.Zds">

    <com.jj.ui.input.JInputLayout
        android:id="@+id/inputSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:jInputClearEnabled="true"
        app:jInputCompact="true"
        app:jInputHint="扫描或输入生产计划号"
        app:jInputMode="scan"
        app:jInputSelectAllOnFocus="true"
        app:jInputTitle="生产计划检索" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProducePlans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_8"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_pda_produce_plan" />
</LinearLayout>
