<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JStyle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="@dimen/j_space_8">

    <View
        android:id="@+id/viewStatus"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/j_space_6"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/JText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="@dimen/j_text_size_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReference"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:maxLines="1"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:singleLine="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/j_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/j_bg_input"
            android:inputType="numberDecimal"
            android:paddingHorizontal="@dimen/j_space_8"
            android:saveEnabled="false"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvUnit"
            style="@style/JText.Caption"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
