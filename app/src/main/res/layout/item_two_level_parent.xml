<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/zds_bg_tree_parent"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/j_space_8"
    android:paddingTop="@dimen/j_space_6"
    android:paddingEnd="@dimen/j_space_8"
    android:paddingBottom="@dimen/j_space_6">

    <TextView
        android:id="@+id/tvToggle"
        style="@style/JText.Body"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textColor="@color/j_color_primary"
        android:textSize="@dimen/j_text_size_lg"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/j_space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/JText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/j_color_primary"
            android:textSize="@dimen/j_text_size_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:maxLines="1"
            android:textColor="@color/j_color_info"
            android:textStyle="bold" />
    </LinearLayout>

    <com.jj.ui.widget.JStatusTagView
        android:id="@+id/tagCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/j_space_8" />
</LinearLayout>
