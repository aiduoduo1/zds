<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pda_bg_page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                style="@style/JStyle.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.jj.ui.input.JInputLayout
                    android:id="@+id/inputCirculation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:jInputClearEnabled="true"
                    app:jInputCompact="true"
                    app:jInputHint="请扫描流转单号"
                    app:jInputMode="scan"
                    app:jInputScanOnly="true"
                    app:jInputSelectAllOnFocus="true"
                    app:jInputTitle="请扫描流转单码" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSheet"
                style="@style/JStyle.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvSheetCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/j_color_text_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvSheetProduct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/j_color_text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvSheetStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pda_bg_status_success" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textColor="@color/j_color_success" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:background="@drawable/pda_bg_card" android:gravity="center" android:text="票面数量" android:textColor="@color/j_color_text_secondary" />
                    <TextView android:id="@+id/tvFaceQuantity" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/pda_bg_circulation_badge_blue" android:gravity="center" android:textColor="@color/j_color_primary" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/pda_bg_card" android:gravity="center" android:text="系统数量" android:textColor="@color/j_color_text_secondary" />
                    <TextView android:id="@+id/tvSystemQuantity" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/pda_bg_circulation_badge_blue" android:gravity="center" android:textColor="@color/j_color_primary" android:textSize="18sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:id="@+id/tvProductName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/j_color_text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/tvProductCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/j_color_text_secondary" />
                <TextView android:id="@+id/tvProductionTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/j_color_text_secondary" />
                <TextView android:id="@+id/tvOperator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/j_color_text_secondary" />
                <TextView android:id="@+id/tvSheetRemark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/pda_bg_card" android:padding="8dp" android:textColor="@color/j_color_text_secondary" />
                <Button android:id="@+id/btnTicketDetail" style="@style/JStyle.Button.Secondary" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:text="查看票面详情" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardReason"
                style="@style/JStyle.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="操作原因（必填）" android:textColor="@color/j_color_text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/tvReason" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/pda_bg_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="请选择作废原因" android:textColor="@color/j_color_text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="备注" android:textColor="@color/j_color_text_primary" android:textStyle="bold" />
                <EditText android:id="@+id/editRemark" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="6dp" android:background="@drawable/pda_bg_card" android:gravity="top|start" android:hint="可补充现场情况" android:padding="10dp" android:textColor="@color/j_color_text_primary" android:textColorHint="@color/j_color_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmDiscard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        android:backgroundTint="#C91D1D"
        android:text="确认作废"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
