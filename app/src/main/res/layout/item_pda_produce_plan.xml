<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/j_space_8"
    android:background="@drawable/pda_bg_card"
    android:orientation="vertical"
    android:padding="@dimen/j_space_12"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlanNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/j_color_text_primary"
            android:textSize="@dimen/j_text_size_md"
            android:textStyle="bold"
            tools:text="WO20260611001" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="@dimen/j_space_10"
            android:paddingEnd="@dimen/j_space_10"
            android:textColor="@color/j_color_success"
            android:textStyle="bold"
            tools:background="@drawable/pda_bg_status_success"
            tools:text="生产中" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:textColor="@color/j_color_text_primary"
        android:textSize="@dimen/j_text_size_sm"
        tools:text="产品：调光器主板" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_6"
        android:textColor="@color/j_color_text_secondary"
        android:textSize="@dimen/j_text_size_sm"
        tools:text="线体：DIP-01    计划：120    已完成：36" />

    <TextView
        android:id="@+id/btnEnter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/j_space_12"
        android:background="@drawable/pda_bg_button_primary"
        android:gravity="center"
        android:text="进入"
        android:textColor="@color/j_color_text_white"
        android:textSize="@dimen/j_text_size_md"
        android:textStyle="bold" />
</LinearLayout>
