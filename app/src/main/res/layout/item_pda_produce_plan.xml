<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/j_space_2"
    android:layout_marginEnd="@dimen/j_space_2"
    android:layout_marginBottom="@dimen/j_space_10"
    app:cardBackgroundColor="@color/j_color_bg_card"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/j_color_line_light"
    app:strokeWidth="1dp"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/j_color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/j_space_12"
            android:paddingTop="@dimen/j_space_10"
            android:paddingEnd="@dimen/j_space_12"
            android:paddingBottom="@dimen/j_space_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlanNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/j_color_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="WO20260611001" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="@dimen/j_space_8"
                android:paddingEnd="@dimen/j_space_8"
                android:textColor="@color/j_color_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:background="@drawable/pda_bg_status_success"
                tools:text="生产中" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_6"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/j_color_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="调光器主板" />

        <TextView
            android:id="@+id/tvPartCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/j_color_text_secondary"
            android:textSize="12sp"
            tools:text="产品号：020102-152-9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/j_color_text_secondary"
                android:textSize="12sp"
                tools:text="线体：DIP-01" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/j_space_8"
                android:textColor="@color/j_color_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="计划数量 120个" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/j_color_text_secondary"
            android:textSize="12sp"
            tools:text="批次：241105-3" />

        <TextView
            android:id="@+id/tvPlanDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_6"
            android:textColor="@color/j_color_text_hint"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="业务日期：2026-06-17"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:textColor="@color/j_color_text_hint"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="计划开始时间：2024-09-11 07:28:09"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvActualStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:textColor="@color/j_color_text_hint"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="实际开始生产时间：2024-09-11 08:00:00"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_8"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnStartSwitch"
                android:layout_width="76dp"
                android:layout_height="32dp"
                android:background="@drawable/pda_bg_button_primary"
                android:gravity="center"
                android:text="开始切换"
                android:textColor="@color/j_color_text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnPause"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/pda_bg_button_warning"
                android:gravity="center"
                android:text="暂停"
                android:textColor="@color/j_color_text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnFinishPlan"
                android:layout_width="76dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/j_space_8"
                android:background="@drawable/pda_bg_button_success"
                android:gravity="center"
                android:text="生产完成"
                android:textColor="@color/j_color_text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnStartPlan"
                android:layout_width="76dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/j_space_8"
                android:background="@drawable/pda_bg_button_primary"
                android:gravity="center"
                android:text="开始生产"
                android:textColor="@color/j_color_text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
