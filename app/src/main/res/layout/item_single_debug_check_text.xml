<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JStyle.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:padding="@dimen/j_space_8">

    <View
        android:id="@+id/viewStatus"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/j_space_6"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/JText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/j_text_size_xs"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRemarkState"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2" />

        <TextView
            android:id="@+id/btnRemark"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/j_space_6"
            android:gravity="center"
            android:text="填写"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
