<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/j_space_8"
    android:paddingBottom="@dimen/j_space_12">

    <LinearLayout
        android:id="@+id/layoutFinishPhoto"
        style="@style/JStyle.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/j_space_10"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/JText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="完工留痕" />

            <TextView
                android:id="@+id/btnTakeFinishPhoto"
                style="@style/JStyle.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/j_small_button_height"
                android:gravity="center"
                android:text="拍照" />

            <RadioGroup
                android:id="@+id/groupFinishPhotoUploadMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/j_space_8"
                android:checkedButton="@id/rbFinishPhotoCompressed"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFinishPhotoCompressed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="压缩图" />

                <RadioButton
                    android:id="@+id/rbFinishPhotoOriginal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原图" />
            </RadioGroup>

            <TextView
                android:id="@+id/btnDeleteFinishPhoto"
                style="@style/JStyle.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/j_small_button_height"
                android:layout_marginStart="@dimen/j_space_8"
                android:gravity="center"
                android:text="删除"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFinishPhotoStatus"
            style="@style/JText.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_6"
            android:text="计划完工前需拍照留痕，最多9张" />

        <ImageView
            android:id="@+id/ivFinishPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="@dimen/j_space_8"
            android:background="@drawable/j_bg_input"
            android:contentDescription="完工拍照预览"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/j_bg_input"
            tools:visibility="visible" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFinishPlan"
        style="@style/JStyle.Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/j_space_8"
        android:text="计划完工" />
</LinearLayout>
