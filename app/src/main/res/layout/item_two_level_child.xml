<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/j_space_16"
    android:background="@drawable/zds_bg_tree_child"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/j_space_8"
    android:paddingTop="@dimen/j_space_4"
    android:paddingEnd="@dimen/j_space_8"
    android:paddingBottom="@dimen/j_space_4">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/j_color_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/j_space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCode"
            style="@style/JText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="@dimen/j_text_size_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRemark"
            style="@style/JText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:maxLines="1"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnEdit"
        android:layout_width="42dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/j_space_4"
        android:gravity="center"
        android:text="编辑"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnRefresh"
        android:layout_width="42dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/j_space_4"
        android:gravity="center"
        android:text="刷新"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="42dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/j_space_4"
        android:gravity="center"
        android:text="删除"
        android:textStyle="bold" />
</LinearLayout>
