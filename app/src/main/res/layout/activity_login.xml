<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg_page"
    android:fitsSystemWindows="false"
    tools:theme="@style/Theme.Zds">

    <FrameLayout
        android:id="@+id/layoutBrand"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/login_bg_brand_panel"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:shadowColor="@color/login_blue_glow"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="16"
                android:text="@string/login_title"
                android:textColor="@color/login_text_white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <View
                android:layout_width="190dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/login_bg_energy_line" />

            <TextView
                android:id="@+id/tvLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/login_subtitle"
                android:textColor="@color/login_text_white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutLoginCard"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/login_bg_card"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBrand">

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:jInputClearEnabled="false"
            app:jInputCompact="true"
            app:jInputHint="@string/login_account_hint"
            app:jInputRequired="false"
            app:jInputTitle="@string/login_account" />

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:jInputClearEnabled="false"
            app:jInputCompact="true"
            app:jInputHint="@string/login_password_hint"
            app:jInputRequired="false"
            app:jInputTitle="@string/login_password" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/login_bg_button"
            android:elevation="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/login_button"
            android:textAllCaps="false"
            android:textColor="@color/login_text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <View
        android:id="@+id/viewFactoryGlow"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:alpha="0.7"
        android:background="@drawable/login_bg_brand_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/login_bg_energy_line"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
