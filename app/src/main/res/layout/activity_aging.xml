<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/JStyle.Page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/j_space_8"
    tools:theme="@style/Theme.Zds">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/pda_bg_filter_unselected"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/btnModeStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/aging_bg_mode_selected"
            android:gravity="center"
            android:text="老化开始"
            android:textColor="@color/j_color_text_white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnModeEnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="老化结束"
            android:textColor="@color/j_color_text_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStartMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_2"
        android:layout_weight="1"
        android:orientation="vertical">

    <LinearLayout
        style="@style/JStyle.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/j_space_8"
        android:paddingEnd="@dimen/j_space_8"

        tools:ignore="RtlSymmetry">

        <com.jj.ui.input.JInputLayout
            android:id="@+id/inputAgingScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:jInputClearEnabled="true"
            app:jInputCompact="true"
            app:jInputHint="请扫描流转单或PRO码"
            app:jInputMode="scan"
            app:jInputScanOnly="true"
            app:jInputSelectAllOnFocus="true"
            app:jInputTitle="产品扫码" />


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_2"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:itemCount="4"
            tools:listitem="@layout/item_aging_product" />

        <com.jj.ui.widget.JEmptyView
            android:id="@+id/emptyProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:jDescription="扫描校验通过的产品会加入待开始列表"
            app:jTitle="暂无待老化产品" />
    </FrameLayout>

    <Button
        android:id="@+id/btnStartAging"
        style="@style/JStyle.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/j_space_8"
        android:gravity="center"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:text="开始老化&#10;共 0 台 · 0 种产品 · 0 个生产计划"
        android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEndMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/j_space_2"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            style="@style/JStyle.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/j_space_8"
            android:paddingEnd="@dimen/j_space_8"
            android:paddingTop="@dimen/j_space_2"

            tools:ignore="RtlSymmetry">

            <com.jj.ui.input.JInputLayout
                android:id="@+id/inputEndAgingScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:jInputClearEnabled="true"
                app:jInputCompact="true"
                app:jInputHint="请扫描单个PRO码"
                app:jInputMode="scan"
                app:jInputScanOnly="true"
                app:jInputSelectAllOnFocus="true"
                app:jInputTitle="结束老化扫码" />


        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/j_space_2"
            android:layout_weight="1">

            <com.jj.ui.widget.JEmptyView
                android:id="@+id/emptyEndDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:jDescription="扫码校验后显示产品及老化信息"
                app:jTitle="等待扫描PRO" />

            <LinearLayout
                android:id="@+id/cardEndDetail"
                style="@style/JStyle.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/j_space_12"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEndProductCode"
                    style="@style/JText.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="PRO20260703000011" />

                <TextView
                    android:id="@+id/tvEndProductName"
                    style="@style/JText.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/j_space_6"
                    tools:text="托盘 / 010903-016" />

                <TextView
                    android:id="@+id/tvEndPlan"
                    style="@style/JText.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/j_space_6"
                    tools:text="生产计划：202607020001" />

                <TextView
                    android:id="@+id/tvEndStartTime"
                    style="@style/JText.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/j_space_6"
                    tools:text="开始时间：2026-07-06 19:03:52" />

                <TextView
                    android:id="@+id/tvEndAgingDuration"
                    style="@style/JText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/j_space_6"
                    android:textStyle="bold"
                    tools:text="当前老化时长：8小时12分钟36秒" />

                <TextView
                    android:id="@+id/tvEndProgress"
                    style="@style/JText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/j_space_12"
                    android:textStyle="bold"
                    tools:text="当前计划老化 OK：0 / 8 台" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEndNg"
                style="@style/JStyle.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/j_button_height"
                android:layout_weight="1"
                android:text="NG · 上报不良" />

            <Button
                android:id="@+id/btnEndOk"
                style="@style/JStyle.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/j_button_height"
                android:layout_marginStart="@dimen/j_space_8"
                android:layout_weight="1"
                android:text="OK · 结束老化" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
