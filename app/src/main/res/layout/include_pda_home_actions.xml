<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/j_space_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pda_bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/j_space_12">

        <include
            layout="@layout/include_pda_group_title"
            android:id="@+id/titleDebug" />

        <TextView
            android:id="@+id/btnSingleDebug"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/j_space_10"
            android:background="@drawable/pda_bg_button_outline"
            android:gravity="center"
            android:text="单个调试"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_12"
        android:background="@drawable/pda_bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/j_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@drawable/pda_bg_group_title_warning" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/j_space_8"
                android:text="品质处理"
                android:textColor="@color/j_color_text_primary"
                android:textSize="@dimen/j_text_size_md"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRepair"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_warning"
                android:gravity="center"
                android:text="维修"
                android:textColor="@color/j_color_text_white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRecheck"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/j_space_8"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_outline"
                android:gravity="center"
                android:text="复检"
                android:textColor="@color/j_color_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_12"
        android:background="@drawable/pda_bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/j_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@drawable/pda_bg_group_title_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/j_space_8"
                android:text="成品物流"
                android:textColor="@color/j_color_text_primary"
                android:textSize="@dimen/j_text_size_md"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnProductIn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_outline"
                android:gravity="center"
                android:text="成品入库"
                android:textColor="@color/j_color_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnProductOut"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/j_space_8"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_outline"
                android:gravity="center"
                android:text="成品出库"
                android:textColor="@color/j_color_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_12"
        android:layout_marginBottom="@dimen/j_space_8"
        android:background="@drawable/pda_bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="@dimen/j_space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@drawable/pda_bg_group_title_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/j_space_8"
                android:text="工具功能"
                android:textColor="@color/j_color_text_primary"
                android:textSize="@dimen/j_text_size_md"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/j_space_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBind"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_outline"
                android:gravity="center"
                android:text="绑定"
                android:textColor="@color/j_color_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnUnbind"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/j_space_8"
                android:layout_weight="1"
                android:background="@drawable/pda_bg_button_outline"
                android:gravity="center"
                android:text="解绑"
                android:textColor="@color/j_color_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMaterialDetail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/j_space_8"
            android:background="@drawable/pda_bg_button_outline"
            android:gravity="center"
            android:text="材料详情"
            android:textColor="@color/j_color_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
