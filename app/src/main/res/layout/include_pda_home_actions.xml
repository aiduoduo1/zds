<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/j_space_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSingleDebug"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_debug"
                android:text="单个调试" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRepair"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_repair"
                android:text="维修" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRecheck"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_check"
                android:text="复检" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProductIn"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_stock_in"
                android:text="成品入库" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProductOut"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_stock_out"
                android:text="成品出库" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAging"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_check"
                android:text="老化管理" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/j_space_8"
        android:layout_marginBottom="@dimen/j_space_8"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBind"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_link"
                android:text="绑定" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUnbind"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_link"
                android:text="解绑" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMaterialDetail"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_material"
                android:text="材料详情" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/j_space_8"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCirculationManage"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/j_color_bg_card"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/j_color_line_light"
            app:strokeWidth="1dp">

            <TextView
                style="@style/PdaHomeActionStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/pda_ic_action_material"
                android:text="流转单管理" />
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/j_space_8"
            android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>
